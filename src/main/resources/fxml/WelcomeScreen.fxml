<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.complainttracking.controller.WelcomeController"
            styleClass="root-pane">

    <!-- ===================== LEFT SIDEBAR ===================== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="260">
            <padding><Insets top="40" right="24" bottom="40" left="24"/></padding>
            <spacing>12</spacing>

            <!-- Brand -->
            <Label text="&#9881;" styleClass="brand-icon"/>
            <Label text="CRTS" styleClass="brand-name"/>
            <Label text="Complaint Registration&#10;&amp; Tracking System"
                   styleClass="brand-tagline" wrapText="true"/>

            <Separator styleClass="sidebar-separator">
                <VBox.margin><Insets top="20" bottom="20"/></VBox.margin>
            </Separator>

            <!-- Nav items (static labels for Phase 1 – buttons in later phases) -->
            <Label text="&#127968;  Home"      styleClass="nav-item nav-active"/>
            <Label text="&#128203;  Complaints" styleClass="nav-item"/>
            <Label text="&#128100;  My Account" styleClass="nav-item"/>
            <Label text="&#128202;  Reports"    styleClass="nav-item"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="v1.0-SNAPSHOT" styleClass="version-label"/>
        </VBox>
    </left>

    <!-- ===================== MAIN CONTENT ===================== -->
    <center>
        <VBox styleClass="content-area" alignment="CENTER" spacing="0">
            <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

            <!-- Hero Section -->
            <VBox alignment="CENTER" spacing="8">
                <Label fx:id="titleLabel"
                       text="Welcome to CRTS"
                       styleClass="hero-title"/>
                <Label fx:id="subtitleLabel"
                       text="A professional platform to register, track and resolve complaints efficiently."
                       styleClass="hero-subtitle"
                       wrapText="true"
                       textAlignment="CENTER"/>
            </VBox>

            <!-- Cards Row -->
            <HBox alignment="CENTER" spacing="24">
                <VBox.margin><Insets top="48" bottom="48"/></VBox.margin>

                <!-- User Card -->
                <VBox styleClass="card" alignment="CENTER" spacing="12" prefWidth="200">
                    <padding><Insets top="32" right="24" bottom="32" left="24"/></padding>
                    <Label text="&#128100;" styleClass="card-icon"/>
                    <Label text="User Portal" styleClass="card-title"/>
                    <Label text="Register and track your complaints"
                           styleClass="card-desc" wrapText="true" textAlignment="CENTER"/>
                    <Button fx:id="userLoginButton"
                            text="User Login"
                            styleClass="btn-primary"
                            onAction="#handleUserLogin"
                            maxWidth="Infinity"/>
                </VBox>

                <!-- Admin Card -->
                <VBox styleClass="card" alignment="CENTER" spacing="12" prefWidth="200">
                    <padding><Insets top="32" right="24" bottom="32" left="24"/></padding>
                    <Label text="&#128737;" styleClass="card-icon"/>
                    <Label text="Admin Portal" styleClass="card-title"/>
                    <Label text="Manage complaints and users"
                           styleClass="card-desc" wrapText="true" textAlignment="CENTER"/>
                    <Button fx:id="adminLoginButton"
                            text="Admin Login"
                            styleClass="btn-secondary"
                            onAction="#handleAdminLogin"
                            maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- DB Status Section -->
            <VBox styleClass="card status-card" alignment="CENTER" spacing="12" maxWidth="460">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                <Label text="Database Status" styleClass="card-title"/>
                <Label fx:id="statusLabel"
                       text="Click the button below to verify database connectivity."
                       styleClass="status-label"
                       wrapText="true"
                       textAlignment="CENTER"/>
                <Button fx:id="checkDbButton"
                        text="Check Database Connection"
                        styleClass="btn-outline"
                        onAction="#handleCheckDatabase"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>
