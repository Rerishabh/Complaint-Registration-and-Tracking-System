<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.complainttracking.controller.WelcomeController"
            prefWidth="1200" prefHeight="760"
            styleClass="root-pane">

    <!-- ===================== LEFT SIDEBAR ===================== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="8">
            <padding><Insets top="32" right="20" bottom="28" left="20"/></padding>

            <!-- Brand -->
            <VBox spacing="4">
                <Label text="&#9881;" styleClass="brand-icon"/>
                <Label text="CRTS" styleClass="brand-name"/>
                <Label text="Complaint Registration&#10;&amp; Tracking System"
                       styleClass="brand-tagline" wrapText="true"/>
            </VBox>

            <Separator styleClass="sidebar-separator">
                <VBox.margin><Insets top="12" bottom="12"/></VBox.margin>
            </Separator>

            <!-- Navigation Items -->
            <VBox spacing="6">
                <Button fx:id="navHomeBtn"
                        text="&#127968;  Home"
                        styleClass="nav-btn nav-btn-active"
                        onAction="#handleNavHome"
                        focusTraversable="false"
                        maxWidth="Infinity"/>
                <Button fx:id="navComplaintsBtn"
                        text="&#128203;  Complaints"
                        styleClass="nav-btn"
                        onAction="#handleNavComplaints"
                        focusTraversable="false"
                        maxWidth="Infinity"/>
                <Button fx:id="navAccountBtn"
                        text="&#128100;  My Account"
                        styleClass="nav-btn"
                        onAction="#handleNavAccount"
                        focusTraversable="false"
                        maxWidth="Infinity"/>
                <Button fx:id="navReportsBtn"
                        text="&#128202;  Reports"
                        styleClass="nav-btn"
                        onAction="#handleNavReports"
                        focusTraversable="false"
                        maxWidth="Infinity"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="v1.0-SNAPSHOT" styleClass="version-label"/>
        </VBox>
    </left>

    <!-- ===================== MAIN CONTENT ===================== -->
    <center>
        <ScrollPane fx:id="welcomeScrollPane"
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="content-scroll-pane">
            <VBox styleClass="content-area" alignment="CENTER" spacing="28">
                <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>

                <!-- Hero Section -->
                <VBox alignment="CENTER" spacing="8">
                    <Label fx:id="titleLabel"
                           text="Welcome to CRTS"
                           styleClass="hero-title"/>
                    <Label fx:id="subtitleLabel"
                           text="A professional platform to register, track and resolve complaints efficiently."
                           styleClass="hero-subtitle"
                           wrapText="true"
                           textAlignment="CENTER"/>
                </VBox>

                <!-- Cards Row -->
                <HBox alignment="CENTER" spacing="24">
                    <!-- User Card -->
                    <VBox styleClass="card" alignment="CENTER" spacing="14" prefWidth="240" minWidth="200" maxWidth="260">
                        <padding><Insets top="28" right="20" bottom="28" left="20"/></padding>
                        <StackPane prefWidth="32" prefHeight="36" alignment="CENTER">
                            <SVGPath content="M 16,15.5 A 7,7 0 1,0 16,1.5 A 7,7 0 1,0 16,15.5 Z M 2,31 C 2,23.5 8,18.5 16,18.5 C 24,18.5 30,23.5 30,31 Z"
                                     styleClass="user-card-icon"/>
                        </StackPane>
                        <Label text="User Portal" styleClass="card-title"/>
                        <Label text="Register and track your complaints"
                               styleClass="card-desc" wrapText="true" textAlignment="CENTER"/>
                        <Button fx:id="userLoginButton"
                                text="User Login"
                                styleClass="btn-primary"
                                onAction="#handleUserLogin"
                                maxWidth="Infinity"/>
                    </VBox>

                    <!-- Admin Card -->
                    <VBox styleClass="card" alignment="CENTER" spacing="14" prefWidth="240" minWidth="200" maxWidth="260">
                        <padding><Insets top="28" right="20" bottom="28" left="20"/></padding>
                        <StackPane prefWidth="32" prefHeight="36" alignment="CENTER">
                            <SVGPath content="M 15,2 L 3,6 L 3,14 C 3,21 8.5,26.5 15,28 C 21.5,26.5 27,21 27,14 L 27,6 Z"
                                     styleClass="admin-shield-icon"/>
                            <SVGPath content="M 9.5,14.5 L 13.5,18.5 L 20.5,10.5"
                                     styleClass="admin-shield-check"/>
                        </StackPane>
                        <Label text="Admin Portal" styleClass="card-title"/>
                        <Label text="Manage complaints and users"
                               styleClass="card-desc" wrapText="true" textAlignment="CENTER"/>
                        <Button fx:id="adminLoginButton"
                                text="Admin Login"
                                styleClass="btn-secondary"
                                onAction="#handleAdminLogin"
                                maxWidth="Infinity"/>
                    </VBox>

                    <!-- Track Complaint Card -->
                    <VBox styleClass="card" alignment="CENTER" spacing="14" prefWidth="240" minWidth="200" maxWidth="260">
                        <padding><Insets top="28" right="20" bottom="28" left="20"/></padding>
                        <Label text="&#128269;" styleClass="card-icon" prefHeight="36" alignment="CENTER"/>
                        <Label text="Track Status" styleClass="card-title"/>
                        <Label text="Quick public lookup with tracking ID"
                               styleClass="card-desc" wrapText="true" textAlignment="CENTER"/>
                        <Button fx:id="trackComplaintButton"
                                text="Track Complaint"
                                styleClass="btn-outline"
                                onAction="#handleTrackComplaint"
                                maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- DB Status Section -->
                <VBox styleClass="card status-card" alignment="CENTER" spacing="12" prefWidth="480" maxWidth="520">
                    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                    <Label text="Database Status" styleClass="card-title"/>
                    <Label fx:id="statusLabel"
                           text="Click the button below to verify database connectivity."
                           styleClass="status-label"
                           wrapText="true"
                           textAlignment="CENTER"/>
                    <Button fx:id="checkDbButton"
                            text="Check Database Connection"
                            styleClass="btn-outline"
                            onAction="#handleCheckDatabase"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
