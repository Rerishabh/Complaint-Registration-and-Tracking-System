<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.complainttracking.controller.UserRegisterController"
            styleClass="root-pane">

    <!-- Top Bar with Back Button -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="16" right="32" bottom="10" left="32"/></padding>
            <Button text="&#8592; Back to Home"
                    styleClass="btn-back"
                    onAction="#handleBackToWelcome"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="CRTS &#8226; User Registration" styleClass="form-subtitle"/>
        </HBox>
    </top>

    <!-- Center Card wrapped in ScrollPane -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox alignment="CENTER">
                <padding><Insets top="10" right="30" bottom="30" left="30"/></padding>

                <VBox styleClass="form-card" maxWidth="520" spacing="16">
                    <padding><Insets top="30" right="36" bottom="30" left="36"/></padding>

                    <!-- Header -->
                    <VBox spacing="4" alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="&#128100;" styleClass="card-icon"/>
                            <VBox spacing="2">
                                <Label text="Create User Account" styleClass="form-title"/>
                                <Label text="Register to submit and track your complaints" styleClass="form-subtitle"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator/>

                    <!-- Form Grid -->
                    <VBox spacing="12">
                        <!-- Full Name -->
                        <VBox spacing="5">
                            <Label text="Full Name *" styleClass="form-label"/>
                            <TextField fx:id="fullNameField"
                                       promptText="e.g., Jane Doe"
                                       maxWidth="Infinity"/>
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="5">
                            <Label text="Email Address *" styleClass="form-label"/>
                            <TextField fx:id="emailField"
                                       promptText="e.g., jane.doe@college.edu"
                                       maxWidth="Infinity"/>
                        </VBox>

                        <!-- Phone and Department Row -->
                        <HBox spacing="14">
                            <!-- Phone -->
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Phone Number" styleClass="form-label"/>
                                <TextField fx:id="phoneField"
                                           promptText="e.g., +91 9876543210"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <!-- Department -->
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Department *" styleClass="form-label"/>
                                <ComboBox fx:id="departmentComboBox"
                                          maxWidth="Infinity"/>
                            </VBox>
                        </HBox>

                        <!-- Password -->
                        <VBox spacing="5">
                            <Label text="Password (min 6 characters) *" styleClass="form-label"/>
                            <PasswordField fx:id="passwordField"
                                           promptText="Create a secure password"
                                           maxWidth="Infinity"/>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="5">
                            <Label text="Confirm Password *" styleClass="form-label"/>
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Re-enter your password"
                                           maxWidth="Infinity"/>
                        </VBox>
                    </VBox>

                    <!-- Status / Error Label -->
                    <Label fx:id="statusLabel"
                           text=""
                           styleClass="form-error-label"
                           wrapText="true"/>

                    <!-- Actions -->
                    <VBox spacing="10" alignment="CENTER">
                        <Button fx:id="registerButton"
                                text="Create Account"
                                styleClass="btn-primary"
                                maxWidth="Infinity"
                                defaultButton="true"
                                onAction="#handleRegister"/>

                        <HBox alignment="CENTER" spacing="6">
                            <Label text="Already have an account?" styleClass="card-desc"/>
                            <Button text="Log in here"
                                    styleClass="link-button"
                                    onAction="#handleGoToLogin"/>
                        </HBox>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

