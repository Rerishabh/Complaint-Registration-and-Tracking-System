<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  AdminDashboard.fxml
  Administrator Dashboard & Complaint Management view.
  Sections:
    1. overviewSection       – 5 KPI cards + Recent complaints table
    2. allComplaintsSection   – Search, 3-criteria filter bar, full TableView, and View Details
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.complainttracking.controller.AdminDashboardController"
            prefWidth="1200" prefHeight="760"
            styleClass="root-pane">

    <!-- =================== LEFT SIDEBAR =================== -->
    <left>
        <VBox styleClass="dashboard-sidebar" prefWidth="240" spacing="4">
            <padding><Insets top="28" right="16" bottom="28" left="16"/></padding>

            <!-- Brand Header -->
            <VBox spacing="2">
                <padding><Insets bottom="12"/></padding>
                <Label text="&#9881;  CRTS" styleClass="dashboard-sidebar-title"/>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Admin Portal" styleClass="dashboard-sidebar-subtitle"/>
                    <Label text="RESTRICTED" styleClass="badge-admin"/>
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: #334155;" opacity="0.5">
                <VBox.margin><Insets top="4" bottom="12"/></VBox.margin>
            </Separator>

            <!-- Navigation Buttons -->
            <Button fx:id="navOverviewBtn"
                    text="&#127968;  Dashboard Overview"
                    styleClass="nav-btn nav-btn-active"
                    onAction="#handleNavOverview"/>

            <Button fx:id="navAllComplaintsBtn"
                    text="&#128203;  All Complaints"
                    styleClass="nav-btn"
                    onAction="#handleNavAllComplaints"/>

            <Button fx:id="navReportsBtn"
                    text="&#128202;  Analytical Reports"
                    styleClass="nav-btn"
                    onAction="#handleNavReports"/>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-background-color: #334155;" opacity="0.5">
                <VBox.margin><Insets bottom="8"/></VBox.margin>
            </Separator>

            <Button text="&#8594;  Logout"
                    styleClass="nav-btn-logout"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- =================== MAIN CONTENT =================== -->
    <center>
        <VBox>
            <!-- TOP HEADER BAR -->
            <HBox styleClass="dashboard-header" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="14" right="28" bottom="14" left="28"/></padding>
                <VBox spacing="2">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="headerAdminName" text="Administrator Name" styleClass="dashboard-header-title"/>
                        <Label fx:id="headerAdminRole" text="ROLE: SUPERADMIN" styleClass="badge-admin"/>
                    </HBox>
                    <Label text="Administrative Complaint Operations &amp; Supervision" styleClass="dashboard-header-dept"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="&#128737;" style="-fx-font-size: 28px;"/>
            </HBox>

            <!-- CONTENT SCROLL PANE -->
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                        style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC;">

                <VBox spacing="0" style="-fx-background-color: #F8FAFC;">

                    <!-- ========== SECTION 1: DASHBOARD OVERVIEW ========== -->
                    <VBox fx:id="overviewSection" spacing="24" visible="true" managed="true">
                        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                        <!-- Heading -->
                        <VBox spacing="4">
                            <Label text="Administrator Dashboard Overview" styleClass="section-title"/>
                            <Label text="System-wide complaint tracking and real-time operational status" styleClass="section-subtitle"/>
                        </VBox>

                        <!-- 5 KPI Cards -->
                        <HBox spacing="14">
                            <!-- Total -->
                            <VBox styleClass="kpi-card" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiTotal" text="0" styleClass="kpi-value"/>
                                <Label text="TOTAL COMPLAINTS" styleClass="kpi-label"/>
                            </VBox>

                            <!-- Open -->
                            <VBox styleClass="kpi-card kpi-open" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiOpen" text="0" styleClass="kpi-value" style="-fx-text-fill: #D97706;"/>
                                <Label text="OPEN" styleClass="kpi-label"/>
                            </VBox>

                            <!-- In Progress -->
                            <VBox styleClass="kpi-card kpi-inprog" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiInProgress" text="0" styleClass="kpi-value" style="-fx-text-fill: #2563EB;"/>
                                <Label text="IN PROGRESS" styleClass="kpi-label"/>
                            </VBox>

                            <!-- Resolved -->
                            <VBox styleClass="kpi-card kpi-done" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiResolved" text="0" styleClass="kpi-value" style="-fx-text-fill: #16A34A;"/>
                                <Label text="RESOLVED" styleClass="kpi-label"/>
                            </VBox>

                            <!-- Rejected -->
                            <VBox styleClass="kpi-card kpi-rejected" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiRejected" text="0" styleClass="kpi-value" style="-fx-text-fill: #DC2626;"/>
                                <Label text="REJECTED" styleClass="kpi-label"/>
                            </VBox>
                        </HBox>

                        <!-- Recent Complaints Table -->
                        <VBox spacing="10">
                            <Label text="Recently Submitted Complaints" styleClass="section-title"/>
                            <TableView fx:id="recentTable" prefHeight="260">
                                <columns>
                                    <TableColumn fx:id="recentTrackingCol"    text="Tracking ID"   prefWidth="130"/>
                                    <TableColumn fx:id="recentTitleCol"       text="Title"         prefWidth="220"/>
                                    <TableColumn fx:id="recentComplainantCol" text="Complainant"   prefWidth="160"/>
                                    <TableColumn fx:id="recentCategoryCol"    text="Category"      prefWidth="130"/>
                                    <TableColumn fx:id="recentPriorityCol"    text="Priority"      prefWidth="90"/>
                                    <TableColumn fx:id="recentStatusCol"      text="Status"        prefWidth="110"/>
                                    <TableColumn fx:id="recentDateCol"        text="Submitted Date" prefWidth="170"/>
                                </columns>
                                <placeholder>
                                    <Label text="No complaints recorded in the system yet." styleClass="form-subtitle"/>
                                </placeholder>
                            </TableView>
                        </VBox>

                    </VBox>

                    <!-- ========== SECTION 2: ALL COMPLAINTS MANAGEMENT ========== -->
                    <VBox fx:id="allComplaintsSection" spacing="16" visible="false" managed="false">
                        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                        <!-- Heading -->
                        <VBox spacing="4">
                            <Label text="All Complaints Management" styleClass="section-title"/>
                            <Label text="Search, filter, and review complaints submitted across all departments" styleClass="section-subtitle"/>
                        </VBox>

                        <!-- Row 1: Filter Bar -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <!-- Search -->
                            <TextField fx:id="searchField"
                                       promptText="&#128269;  Search Tracking ID, Title, Complainant, Email..."
                                       styleClass="search-field"
                                       prefWidth="260"/>

                            <!-- Status Filter -->
                            <ComboBox fx:id="statusFilterCombo" prefWidth="135"/>

                            <!-- Category Filter -->
                            <ComboBox fx:id="categoryFilterCombo" prefWidth="145"/>

                            <!-- Priority Filter -->
                            <ComboBox fx:id="priorityFilterCombo" prefWidth="130"/>

                            <!-- Reset Button -->
                            <Button text="Reset"
                                    styleClass="btn-outline"
                                    onAction="#handleResetFilters"/>
                        </HBox>

                        <!-- Row 2: Action Bar -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="&#128065; View Details"
                                    minWidth="120"
                                    styleClass="btn-outline"
                                    onAction="#handleViewDetails"/>

                            <Button text="&#9881; Update Status"
                                    minWidth="120"
                                    styleClass="btn-outline"
                                    onAction="#handleUpdateStatus"/>

                            <Button text="&#128100; Assign Staff"
                                    minWidth="120"
                                    styleClass="btn-outline"
                                    onAction="#handleAssignComplaint"/>

                            <Button text="&#9989; Resolve"
                                    minWidth="120"
                                    styleClass="btn-primary"
                                    onAction="#handleResolveComplaint"/>
                        </HBox>

                        <!-- All Complaints Table -->
                        <TableView fx:id="complaintsTable" VBox.vgrow="ALWAYS" prefHeight="420">
                            <columns>
                                <TableColumn fx:id="colId"          text="ID"            prefWidth="50"  minWidth="40"/>
                                <TableColumn fx:id="colTracking"    text="Tracking ID"   prefWidth="130" minWidth="110"/>
                                <TableColumn fx:id="colComplainant" text="Complainant"   prefWidth="150" minWidth="120"/>
                                <TableColumn fx:id="colCategory"    text="Category"      prefWidth="130" minWidth="110"/>
                                <TableColumn fx:id="colTitle"       text="Title"         prefWidth="220" minWidth="150"/>
                                <TableColumn fx:id="colPriority"    text="Priority"      prefWidth="90"  minWidth="80"/>
                                <TableColumn fx:id="colStatus"      text="Status"        prefWidth="110" minWidth="95"/>
                                <TableColumn fx:id="colAssigned"    text="Assigned Staff" prefWidth="140" minWidth="120"/>
                                <TableColumn fx:id="colDate"        text="Created Date"  prefWidth="160" minWidth="140"/>
                            </columns>
                            <placeholder>
                                <Label text="No complaints found matching the criteria." styleClass="form-subtitle"/>
                            </placeholder>
                        </TableView>

                        <Label text="Tip: Select any row and click 'View Details' to inspect the complaint description, contact details, and status history."
                               styleClass="form-subtitle"/>

                    </VBox>

                    <!-- ========== SECTION 3: ANALYTICAL REPORTS ========== -->
                    <VBox fx:id="reportsSection" spacing="20" visible="false" managed="false">
                        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                        <!-- Section Header -->
                        <VBox spacing="4">
                            <Label text="Analytical Reports &amp; Charts" styleClass="section-title"/>
                            <Label text="Executive overview, distribution analytics, trend charts, and staff performance" styleClass="section-subtitle"/>
                        </VBox>

                        <!-- Reports Filter Toolbar -->
                        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-card">
                            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

                            <Label text="Start Date:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <DatePicker fx:id="reportStartDatePicker" promptText="YYYY-MM-DD" prefWidth="135"/>

                            <Label text="End Date:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <DatePicker fx:id="reportEndDatePicker" promptText="YYYY-MM-DD" prefWidth="135"/>

                            <Button fx:id="btnApplyReportFilter"
                                    text="&#128269; Apply Filter"
                                    styleClass="btn-primary"
                                    onAction="#handleApplyReportFilter"/>

                            <Button fx:id="btnResetReportFilter"
                                    text="&#10226; Reset"
                                    styleClass="btn-outline"
                                    onAction="#handleResetReportFilter"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="reportStatusLabel" text="" styleClass="form-subtitle"/>

                            <Button fx:id="btnExportReportCsv"
                                    text="&#128229; Export CSV"
                                    styleClass="btn-success"
                                    onAction="#handleExportReportCsv"/>
                        </HBox>

                        <!-- Executive KPI Cards -->
                        <HBox spacing="14">
                            <!-- Total Complaints -->
                            <VBox styleClass="kpi-card" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiReportTotal" text="0" styleClass="kpi-value"/>
                                <Label text="TOTAL COMPLAINTS" styleClass="kpi-label"/>
                            </VBox>

                            <!-- Resolution Rate -->
                            <VBox styleClass="kpi-card kpi-done" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiReportResolutionRate" text="0.0%" styleClass="kpi-value" style="-fx-text-fill: #059669;"/>
                                <Label text="RESOLUTION RATE" styleClass="kpi-label"/>
                            </VBox>

                            <!-- Resolved Complaints -->
                            <VBox styleClass="kpi-card" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiReportResolved" text="0" styleClass="kpi-value" style="-fx-text-fill: #2563EB;"/>
                                <Label text="RESOLVED" styleClass="kpi-label"/>
                            </VBox>

                            <!-- Pending Complaints -->
                            <VBox styleClass="kpi-card kpi-open" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiReportPending" text="0" styleClass="kpi-value" style="-fx-text-fill: #D97706;"/>
                                <Label text="PENDING" styleClass="kpi-label"/>
                            </VBox>

                            <!-- Avg Resolution Time -->
                            <VBox styleClass="kpi-card" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                                <Label fx:id="kpiReportAvgTime" text="0.0 hrs" styleClass="kpi-value" style="-fx-text-fill: #7C3AED;"/>
                                <Label text="AVG RESOLUTION TIME" styleClass="kpi-label"/>
                            </VBox>
                        </HBox>

                        <!-- Chart Row 1: Category Distribution & Status Distribution -->
                        <HBox spacing="16">
                            <!-- Category Pie Chart -->
                            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="480">
                                <PieChart fx:id="categoryPieChart" title="Complaints by Category" legendSide="BOTTOM" prefHeight="330" animated="false"/>
                            </VBox>

                            <!-- Status Bar Chart -->
                            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="480">
                                <BarChart fx:id="statusBarChart" title="Complaints by Status" legendVisible="false" prefHeight="330" animated="false">
                                    <xAxis>
                                        <CategoryAxis fx:id="statusXAxis" label="Status" animated="false"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Count" animated="false"/>
                                    </yAxis>
                                </BarChart>
                            </VBox>
                        </HBox>

                        <!-- Chart Row 2: Department Distribution & Monthly Trends -->
                        <HBox spacing="16">
                            <!-- Department Bar Chart -->
                            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="480">
                                <BarChart fx:id="departmentBarChart" title="Complaints by Department" legendVisible="false" prefHeight="330" animated="false">
                                    <xAxis>
                                        <CategoryAxis fx:id="departmentXAxis" label="Department" animated="false"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Count" animated="false"/>
                                    </yAxis>
                                </BarChart>
                            </VBox>

                            <!-- Monthly Trends Line Chart -->
                            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="480">
                                <LineChart fx:id="monthlyTrendsChart" title="Monthly Registration Trends" legendVisible="false" prefHeight="330" animated="false">
                                    <xAxis>
                                        <CategoryAxis fx:id="monthlyTrendsXAxis" label="Month (YYYY-MM)" animated="false"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="New Registrations" animated="false"/>
                                    </yAxis>
                                </LineChart>
                            </VBox>
                        </HBox>

                        <!-- Staff Performance Section -->
                        <VBox spacing="10">
                            <VBox spacing="2">
                                <Label text="Staff Resolution Performance" styleClass="section-title" style="-fx-font-size: 18px;"/>
                                <Label text="Assignment volume, completion counts, resolution percentage, and turnaround speed by staff member" styleClass="section-subtitle"/>
                            </VBox>

                            <TableView fx:id="staffPerformanceTable" prefHeight="260">
                                <columns>
                                    <TableColumn fx:id="colStaffName"     text="Staff Name"            prefWidth="200" minWidth="150"/>
                                    <TableColumn fx:id="colStaffRole"     text="Role"                  prefWidth="130" minWidth="100"/>
                                    <TableColumn fx:id="colStaffAssigned" text="Assigned Complaints"   prefWidth="150" minWidth="120"/>
                                    <TableColumn fx:id="colStaffResolved" text="Resolved Complaints"   prefWidth="150" minWidth="120"/>
                                    <TableColumn fx:id="colStaffRate"     text="Resolution Rate"       prefWidth="140" minWidth="120"/>
                                    <TableColumn fx:id="colStaffAvgTime"  text="Avg. Resolution Time"  prefWidth="160" minWidth="140"/>
                                </columns>
                                <placeholder>
                                    <Label text="No staff performance records available for this reporting period." styleClass="form-subtitle"/>
                                </placeholder>
                            </TableView>
                        </VBox>

                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>

